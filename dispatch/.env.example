# Copy to .env on the VPS and fill in. Never commit the real .env.
PORT=3000
PUBLIC_BASE_URL=https://fingertip.in

# Supabase → Project Settings → Database → Connection string (pooler, service role)
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# Only used to check driver app logins
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=

# Meta → WhatsApp → API setup (number +91 78424 49808)
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_APP_SECRET=
WA_VERIFY_TOKEN=pick-any-long-random-string
WA_GRAPH_VERSION=v23.0

SARVAM_API_KEY=
SARVAM_MODEL=saaras:v4

# Optional pre-recorded Telugu voice notes (public https links)
AUDIO_ASK_LOCATION_URL=
AUDIO_CONFIRMED_URL=
AUDIO_NO_AUTO_URL=

# Optional: Firebase service account JSON (one line) to wake the driver app
FCM_SERVICE_ACCOUNT_JSON=

# Optional: Exotel fallback call when WhatsApp outcome isn't read in 20 s
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_CALLER_ID=
EXOTEL_FLOW_URL_CONFIRMED=
EXOTEL_FLOW_URL_NO_AUTO=
